# ==============================================================================
# DataGuard 2.0 Enterprise Environment Configuration Template
# Copy this file to .env and provide your production or local development values.
# ==============================================================================

# Environment (development | staging | production)
ENV=development

# Secret key for JWT tokens and cryptographic audit HMAC signing
# In production, this MUST be a cryptographically secure random 256-bit hex string.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dataguard_secret_key_2026

# Token expiration in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=dataguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Message Broker URL (for Celery background tasks)
REDIS_URL=redis://localhost:6379/0

# Google Gemini LLM API Key (for CopilotAgent AI explanations)
# If omitted or unset, CopilotAgent automatically uses evidence-grounded rules.
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Security & CORS Origins (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Demo Users Seeding (allow only in development)
ALLOW_SEED_DEMO_USERS=true
