# -------------------------------------------------------------
# DataGuard Backend Environment Variables (Production & Local)
# -------------------------------------------------------------

# PostgreSQL Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:password@localhost:5432/dataguard

# JWT Security
SECRET_KEY=replace_with_a_secure_random_production_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated for production frontend domains)
# Example: https://dataguard-frontend.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Port to bind (set automatically by Render / container platforms)
PORT=8000

# Optional SQL query echo logging (true/false)
SQL_ECHO=false

# Optional Redis URL (if Celery worker is enabled)
REDIS_URL=redis://localhost:6379/0
